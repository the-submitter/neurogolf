flowchart TB
    state["Task selection and repository state"] --> control["Deterministic Python control plane"]

    control --- responsibilities["Concurrency and process supervision<br/>Locks, timeouts, retries, and cancellation<br/>Structured logs and summaries<br/>Artifact and completion verification"]

    control --> worker_a["Codex worker A"]
    control --> worker_b["Codex worker B"]
    control --> worker_c["Codex worker C"]

    worker_a --> task_a["Task-local ARC reasoning<br/>Generator inspection<br/>ONNX synthesis, testing, and optimization"]
    worker_b --> task_b["Task-local ARC reasoning<br/>Generator inspection<br/>ONNX synthesis, testing, and optimization"]
    worker_c --> task_c["Task-local ARC reasoning<br/>Generator inspection<br/>ONNX synthesis, testing, and optimization"]

    task_a --> verify["Validation and official scoring"]
    task_b --> verify
    task_c --> verify

    verify --> artifacts["Verified task-local builders, explanations,<br/>and ONNX submissions"]

    classDef controlPlane fill:#e8f1ff,stroke:#2767b2,stroke-width:2px,color:#102a43;
    classDef worker fill:#fff3d6,stroke:#b7791f,stroke-width:1.5px,color:#4a2c00;
    classDef task fill:#f3edff,stroke:#6b46c1,stroke-width:1.5px,color:#2d1b4e;
    classDef output fill:#e8f8ef,stroke:#27864a,stroke-width:2px,color:#123c24;

    class control,responsibilities controlPlane;
    class worker_a,worker_b,worker_c worker;
    class task_a,task_b,task_c task;
    class state,verify,artifacts output;
