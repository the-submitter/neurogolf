{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurogolf.local/schemas/failure_packet.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "candidate_sha256", "judge_version", "task_num", "task_id",
    "failure_count", "failure_families", "failure_signatures",
    "representative_failures", "scorer_diagnostics"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "judge_version": {"type": "string"},
    "task_num": {"type": "integer", "minimum": 1, "maximum": 400},
    "task_id": {"type": "string", "pattern": "^[0-9a-f]{8}$"},
    "failure_count": {"type": "integer", "minimum": 1},
    "failure_families": {"type": "object", "additionalProperties": {"type": "integer"}},
    "failure_signatures": {"type": "object", "additionalProperties": {"type": "integer"}},
    "representative_failures": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["input", "expected", "actual", "pixel_differences", "shape_difference", "special_output_colors", "malformed_one_hot", "runtime_error", "seed", "family", "failure_signature", "pixel_difference_count", "passed"]
      }
    },
    "scorer_diagnostics": {"type": "object"}
  }
}
