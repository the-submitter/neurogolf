{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurogolf.local/schemas/codex_result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_num", "task_id", "status", "summary", "candidate_path", "candidate_sha256", "gate_result_path", "commands", "tests", "next_action"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "task_num": {"type": "integer", "minimum": 1, "maximum": 400},
    "task_id": {"type": "string", "pattern": "^[0-9a-f]{8}$"},
    "status": {"type": "string", "enum": ["passed", "failed", "blocked", "reviewed"]},
    "summary": {"type": "string"},
    "candidate_path": {"type": ["string", "null"]},
    "candidate_sha256": {"type": ["string", "null"]},
    "gate_result_path": {"type": ["string", "null"]},
    "commands": {"type": "array", "items": {"type": "string"}},
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed", "details"],
        "properties": {
          "name": {"type": "string"},
          "passed": {"type": "boolean"},
          "details": {"type": ["string", "null"]}
        }
      }
    },
    "next_action": {"type": "string"}
  }
}
