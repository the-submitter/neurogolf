{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurogolf.local/schemas/dossier.schema.json",
  "title": "NeuroGolf task dossier",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_num",
    "task_id",
    "arcgen_principle",
    "sources",
    "source_counts",
    "examples",
    "local_rules",
    "generator",
    "official_scorer",
    "current_champion",
    "existing_failure_summaries"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_num": {"type": "integer", "minimum": 1, "maximum": 400},
    "task_id": {"type": "string", "pattern": "^[0-9a-f]{8}$"},
    "arcgen_principle": {"type": "string", "minLength": 1},
    "sources": {"type": "object", "required": ["kaggle_json", "arcgen_generator", "arc_agi_json", "arc_agi_split"]},
    "source_counts": {"type": "object"},
    "examples": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "local_rules": {"type": "object", "required": ["change_table", "bounded_receptive_field"]},
    "generator": {"type": "object", "required": ["source", "source_sha256", "generate_signature", "ast_summary", "write_relationships"]},
    "official_scorer": {"type": "object", "required": ["official_utils_sha256", "shape", "threshold", "excluded_ops", "objective", "points"]},
    "current_champion": {"type": ["object", "null"]},
    "existing_failure_summaries": {"type": "array", "items": {"type": "object"}}
  }
}
