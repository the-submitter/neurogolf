{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurogolf.local/schemas/gate_result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "judge_version", "status", "eligible_for_promotion",
    "task_num", "task_id", "candidate_path", "candidate_sha256",
    "candidate_size_bytes", "integrity", "legality", "suites", "score",
    "champion_comparison", "failure_packet_path", "fuzz_nonce", "errors",
    "started_at", "completed_at", "duration_seconds"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "judge_version": {"type": "string"},
    "status": {"enum": ["passed", "candidate_failure", "infrastructure_error"]},
    "eligible_for_promotion": {"type": "boolean"},
    "task_num": {"type": "integer", "minimum": 1, "maximum": 400},
    "task_id": {"type": "string", "pattern": "^[0-9a-f]{8}$"},
    "candidate_path": {"type": "string"},
    "candidate_sha256": {"type": ["string", "null"]},
    "candidate_size_bytes": {"type": ["integer", "null"], "minimum": 0},
    "integrity": {"type": "object"},
    "legality": {"type": "object"},
    "suites": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "required", "total", "passed", "failed", "skipped", "seeds"],
        "properties": {
          "name": {"type": "string"}, "required": {"type": "boolean"},
          "total": {"type": "integer", "minimum": 0}, "passed": {"type": "integer", "minimum": 0},
          "failed": {"type": "integer", "minimum": 0}, "skipped": {"type": "integer", "minimum": 0},
          "seeds": {"type": "array", "items": {"type": "integer"}}
        }
      }
    },
    "score": {"type": ["object", "null"]},
    "champion_comparison": {"type": ["object", "null"]},
    "failure_packet_path": {"type": ["string", "null"]},
    "fuzz_nonce": {"type": ["integer", "null"]},
    "errors": {"type": "array", "items": {"type": "string"}},
    "started_at": {"type": "string"}, "completed_at": {"type": "string"},
    "duration_seconds": {"type": "number", "minimum": 0}
  }
}
